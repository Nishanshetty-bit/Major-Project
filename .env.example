# Express
PORT=5000
STORE_FILE=.data/store.json

# Optional FastAPI ML service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=2500

# Public GDELT DOC news integration (no API credential required)
NEWS_TIMEOUT_MS=6000

# Gemini AI assistant (server only; keep the API key out of client configuration).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional 0xramm Indian Stock Market API base URL.
# Defaults to the local Wrangler worker at http://127.0.0.1:8787 when unset.
# Quotes are display-only, sourced upstream from Yahoo Finance, and are never
# used by historical training or return prediction.
INDIAN_STOCK_API_BASE_URL=http://127.0.0.1:8787
INDIAN_STOCK_TIMEOUT_MS=4000
INDIAN_STOCK_CACHE_TTL_MS=30000
INDIAN_STOCK_STALE_MAX_MS=600000

# Optional prepared market data location
# MARKET_DATA_DIR=../ml/data/processed
